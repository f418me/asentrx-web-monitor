# --- General Configuration ---

# Webservice details where data will be sent
WEBSERVICE_HOST="your.webservice.host"    # e.g., api.example.com
WEBSERVICE_PORT="443"                     # e.g., 80 or 443 (use 443 for HTTPS)

# --- Logging Configuration ---
# Set the logging level for console output.
# Options: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET
# Default is INFO if not set or an invalid value is provided.
LOG_LEVEL="DEBUG" # Change to "DEBUG" to see full extracted content and more verbose logs


# --- Web Page Monitor Configuration ---
# The base URL of the website to monitor
MONITOR_BASE_URL="https://www.federalreserve.gov"

# The path to the main page (often just '/')
MONITOR_MAIN_PAGE_PATH="/"

# How often the website should be checked (in seconds, default 5 minutes)
MONITOR_INTERVAL_SECONDS="300"

# How many of the most recent articles should be checked on each cycle
MONITOR_RECENT_ARTICLES_COUNT="2"

# Optional: Only process articles if their TITLE contains this keyword (case-insensitive).
# Leave empty to disable title filtering. This filter is applied BEFORE fetching article content.
#MONITOR_TITLE_KEYWORD="Fargo" # Example: Only process if "press release" is in the title

# Optional: Only process articles if their CONTENT contains this keyword (case-insensitive).
# Leave empty to disable content filtering. This filter is applied AFTER fetching article content.
#MONITOR_KEYWORD="inflation"