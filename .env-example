# --- Destination ---
WEBSERVICE_URL="https://asentrx-trade-decision-engine.fly.dev/notify/web-monitor"
TRADE_ENGINE_AUTH_TOKEN="same_long_random_secret_as_engine_NOTIFY_AUTH_TOKEN"
# Optional. On Fly, this may be absent; the monitor falls back to Fly machine identifiers.
FLY_PUBLIC_IP=""

# --- Logging Configuration ---
LOG_LEVEL="INFO"

# --- Monitor Target ---
# Set to "fomc" for the Fed press-release index, "nfp" for the BLS Employment Situation page, or "cpi" for the BLS CPI page.
MONITOR_TARGET_KIND="fomc"

# --- Web Page Monitor Configuration ---
MONITOR_BASE_URL="https://www.federalreserve.gov"
MONITOR_MAIN_PAGE_PATH="/newsevents/pressreleases/2026-press-fomc.htm"
MONITOR_RECENT_ARTICLES_COUNT="5"

# Optional: Only process items if their TITLE contains this keyword (case-insensitive).
MONITOR_TITLE_KEYWORD="fomc statement"

# Optional: Only process items if their CONTENT contains this keyword (case-insensitive).
MONITOR_KEYWORD=""

# --- Monitor Modes ---
MONITOR_MODE="normal"
MONITOR_INTERVAL_SECONDS="300"
MONITOR_PROD_MIN_SECONDS="10"
MONITOR_PROD_MAX_SECONDS="20"
# For pre-event deployment, keep this true so the currently visible older release is not sent.
# If deploying only after the new release is already live, set this to false for the first run.
MONITOR_BOOTSTRAP_SKIP_EXISTING="true"
