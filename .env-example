# --- Destination ---
WEBSERVICE_URL="https://asentrx-trade-decision-engine.fly.dev/notify/web-monitor"
TRADE_ENGINE_AUTH_TOKEN="same_long_random_secret_as_engine_NOTIFY_AUTH_TOKEN"
# Optional. On Fly, this may be absent; the monitor falls back to Fly machine identifiers.
FLY_PUBLIC_IP=""

# --- Logging Configuration ---
LOG_LEVEL="INFO"

# --- Monitor Target ---
# Targets: "fomc", "nfp", "cpi", or the bounded BEA "pce" event.
MONITOR_TARGET_KIND="pce"
# Approved event: Nov 25, 2026 14:30 Europe/Zurich = 13:30 UTC.
# Required for PCE. Fetch/send window is [13:30, 13:35) UTC, with no late replay.
PCE_RELEASE_AT="2026-11-25T13:30:00+00:00"
PCE_REFERENCE_MONTH="2026-10"
# Optional fast FOMC event mode. Set an explicit future release timestamp with offset.
# Historical format example only: 2026-10-28T14:00:00-04:00
# Empty keeps legacy index polling. Expired event timestamps never replay releases.
FOMC_RELEASE_AT=""

# --- Web Page Monitor Configuration ---
MONITOR_BASE_URL="https://www.bea.gov"
MONITOR_MAIN_PAGE_PATH="/news/2026/personal-income-and-outlays-october-2026"
MONITOR_RECENT_ARTICLES_COUNT="5"

# Optional: Only process items if their TITLE contains this keyword (case-insensitive).
MONITOR_TITLE_KEYWORD="personal income and outlays"

# Optional: Only process items if their CONTENT contains this keyword (case-insensitive).
MONITOR_KEYWORD=""

# --- Monitor Modes ---
MONITOR_MODE="production"
MONITOR_INTERVAL_SECONDS="300"
MONITOR_PROD_MIN_SECONDS="3"
MONITOR_PROD_MAX_SECONDS="8"
# Applies only to legacy modes. PCE and fast FOMC validate their event windows
# instead, so a valid in-window release is not skipped on a fresh instance.
MONITOR_BOOTSTRAP_SKIP_EXISTING="true"
